{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "www-room",
  "main": "./index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      },
      {
        "name": "FLEET",
        "class_name": "FleetStore"
      }
    ]
  },
  // Takes the namespace (and its data) over from `www`.
  "migrations": [
    {
      "tag": "v1",
      "transferred_classes": [
        {
          "from": "Room",
          "from_script": "www",
          "to": "Room"
        }
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["FleetStore"]
    }
  ]
}
