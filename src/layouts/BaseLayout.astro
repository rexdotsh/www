---
import "../styles.css";
import "../post.css";
import CornerNotes from "../components/corner-notes.tsx";
import geistMonoWoff2 from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import instrumentItalicWoff2 from "@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url";
import instrumentWoff2 from "@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url";

interface Props {
  baseUrl: string;
  description: string;
  imageName?: "rex" | "mridul";
  imagePath?: string;
  isPublicHost: boolean;
  name: string;
  publishedDate?: string;
  rss?: boolean;
  title: string;
}

const {
  baseUrl,
  description,
  imageName = "rex",
  imagePath,
  isPublicHost,
  name,
  publishedDate,
  rss = false,
  title,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, baseUrl).href;
const imageUrl = new URL(
  `${imagePath ?? `/${imageName === "mridul" ? "social-card-mridul.png" : "social-card-rex.png"}`}?v=${import.meta.env.VITE_OG_IMAGE_VERSION ?? "dev"}`,
  baseUrl
).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#faf8f2" />
    <meta name="description" content={description} />
    <meta name="author" content={name} />
    <meta name="robots" content={isPublicHost ? "index,follow" : "noindex,nofollow"} />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/image.png" />
    <link rel="preload" href={geistMonoWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={instrumentWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={instrumentItalicWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    {rss && <link rel="alternate" type="application/rss+xml" title="writing — rss" href="/blog/rss.xml" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={title === `${name}'s space` ? "website" : "article"} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title} />
    {publishedDate && <meta property="article:published_time" content={publishedDate} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:site" content="@rexmkv" />
    <meta name="twitter:creator" content="@rexmkv" />
    {publishedDate && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        datePublished: publishedDate,
        description,
        headline: title,
        image: imageUrl,
        mainEntityOfPage: canonicalUrl,
        url: canonicalUrl,
      })} />
    )}
    <link rel="preconnect" href="https://ingest.rex.wf" />
    <script is:inline>{`try{if(localStorage.getItem("theme")==="dark")document.documentElement.dataset.theme="dark"}catch(e){}`}</script>
    {title === `${name}'s space` && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@graph": [
          { "@type": "WebSite", description, name: title, url: canonicalUrl },
          { "@type": "Person", name, sameAs: ["https://github.com/rexdotsh", "https://x.com/rexmkv"], url: canonicalUrl },
        ],
      })} />
    )}
    <script src="https://ingest.rex.wf/script.js" async data-website-id="de1c2b87-5ec8-4a14-b3f4-5b3b76599ba1"></script>
  </head>
  <body class="antialiased">
    <CornerNotes client:load />
    <slot />
  </body>
</html>
