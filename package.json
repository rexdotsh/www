{
  "name": "www",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types --include-runtime false --env-file .dev.vars.example",
    "deploy": "bun run build && wrangler deploy",
    "dev": "vite dev",
    "format": "biome format --write .",
