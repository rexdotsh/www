{
  "name": "www",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "cf-typegen": "wrangler types --include-runtime false --env-file .dev.vars.example -c wrangler.jsonc -c workers/room/wrangler.jsonc",
    "deploy": "bun run build && wrangler deploy",
    "deploy:room": "wrangler deploy -c workers/room/wrangler.jsonc",
    "dev": "vite dev",
    "fleet:key": "bun --env-file=.dev.vars scripts/fleet-key.ts",
    "fonts:subset": "uv run scripts/subset-fonts.py",
    "format": "oxfmt",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt",
    "og:gen": "bun scripts/generate-og.ts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.2",
    "obscenity": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@cloudflare/workers-types": "^5.20261014.1",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@mdx-js/rollup": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/langs": "4.5.0",
    "@shikijs/rehype": "^4.5.0",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.2",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "remark-reading-time": "^2.1.0",
    "satori": "~0.33.5",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "4.151.0"
  }
}
