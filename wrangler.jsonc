{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "www",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": true,
  "cache": {
    "enabled": true
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "SPOTIFY_TOKENS",
      "id": "03d58d1db51b477085e75f3d5aa7c977"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "Room"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Room"]
    }
  ]
}
