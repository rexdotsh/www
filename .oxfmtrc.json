{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "trailingComma": "es5",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.json", "*.jsonc"],
      "options": { "trailingComma": "none" }
    }
  ],
  "ignorePatterns": [
    "bun.lock",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    ".output",
    "agent",
    "**/*.md",
    "**/*.mdx",
    "**/*.yml",
    "**/*.html"
  ]
}
